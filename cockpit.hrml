<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Elayon Space • Cockpit do Piloto</title>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
        :root {
            --bg1: #f4f9f4;
            --bg2: #eaf4f6;
            --card: #ffffff;
            --ink: #0a2a2f;
            --muted: #4a6b70;
            --line: #d8e8eb;
            --accent: #2a9d8f;
            --accent-glow: rgba(42, 157, 143, 0.15);
            --success: #2b8a3e;
            --danger: #d9534f;
            --shadow: 0 10px 30px rgba(0,0,0,0.06);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            min-height: 100vh;
            background: radial-gradient(circle at top left, var(--bg1), var(--bg2));
            color: var(--ink);
            font-family: system-ui, -apple-system, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
        }

        .container {
            width: 100%;
            max-width: 600px;
        }

        /* Header / Barra de Navegação */
        .hud-header {
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 16px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            box-shadow: var(--shadow);
        }

        .hud-info {
            font-size: 12px;
            font-weight: 700;
            color: var(--muted);
        }

        .hud-info span {
            color: var(--accent);
        }

        .btn-perfil {
            background: var(--bg2);
            border: 1px solid var(--line);
            color: var(--ink);
            padding: 8px 14px;
            border-radius: 10px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            transition: 0.2s;
        }

        .btn-perfil:hover {
            background: var(--accent);
            color: #fff;
        }

        /* Card Principal do Piloto */
        .profile-card {
            background: var(--card);
            border-radius: 20px;
            padding: 24px;
            border: 1px solid var(--line);
            margin-bottom: 20px;
            box-shadow: var(--shadow);
            text-align: center;
        }

        .logo-img {
            max-width: 80px;
            border-radius: 50%;
            margin-bottom: 12px;
            border: 2px solid var(--accent);
        }

        .profile-card h2 {
            font-size: 22px;
            color: var(--ink);
            margin-bottom: 4px;
        }

        .profile-card p {
            font-size: 13px;
            color: var(--muted);
            margin-bottom: 16px;
        }

        .saldo-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #f8fbfa;
            padding: 14px 18px;
            border-radius: 12px;
            border: 1px solid var(--line);
            font-size: 14px;
        }

        .saldo-texto strong {
            color: var(--accent);
            font-size: 18px;
        }

        /* Seção de Configuração de IA Externa */
        .ai-config-card {
            background: var(--card);
            border-radius: 16px;
            padding: 20px;
            border: 1px solid var(--line);
            margin-bottom: 20px;
            box-shadow: var(--shadow);
            text-align: left;
        }

        .ai-config-card h3 {
            font-size: 14px;
            margin-bottom: 12px;
            color: var(--ink);
        }

        .input-group {
            margin-bottom: 10px;
        }

        .input-group label {
            display: block;
            font-size: 11px;
            font-weight: 700;
            color: var(--muted);
            margin-bottom: 4px;
            text-transform: uppercase;
        }

        .input-group select, .input-group input {
            width: 100%;
            padding: 10px;
            border: 1px solid var(--line);
            border-radius: 8px;
            font-size: 13px;
            outline: none;
            background: #fafcfc;
        }

        /* Área de Chat / IA Global (Ad) */
        .chat-section {
            background: var(--card);
            border-radius: 20px;
            padding: 20px;
            border: 1px solid var(--line);
            box-shadow: var(--shadow);
            margin-bottom: 20px;
        }

        .chat-box {
            background: #f8fbfa;
            border: 1px solid var(--line);
            border-radius: 12px;
            height: 220px;
            overflow-y: auto;
            padding: 15px;
            margin-bottom: 12px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .chat-message {
            font-size: 13px;
            padding: 10px 14px;
            border-radius: 10px;
            max-width: 85%;
            line-height: 1.4;
        }

        .chat-message.ad {
            background: #e2f1f0;
            color: var(--ink);
            align-self: flex-start;
            border-left: 4px solid var(--accent);
        }

        .chat-message.user {
            background: var(--accent);
            color: #fff;
            align-self: flex-end;
        }

        /* Botões de Ação e Calibração */
        .section-label {
            font-size: 11px;
            font-weight: bold;
            color: var(--muted);
            margin: 20px 0 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
            display: flex;
            align-items: center;
        }

        .section-label::after {
            content: "";
            flex: 1;
            height: 1px;
            background: var(--line);
            margin-left: 10px;
        }

        .btn-action {
            display: block;
            width: 100%;
            padding: 14px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 800;
            border: none;
            cursor: pointer;
            text-align: center;
            transition: 0.2s;
            text-decoration: none;
            margin-bottom: 10px;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--accent), #3ecfcf);
            color: #fff;
            box-shadow: 0 4px 15px var(--accent-glow);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
        }

        .btn-disabled {
            background: #e0e8e8;
            color: #88a0a4;
            cursor: not-allowed;
            pointer-events: none;
        }

        .tool-grid {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .tool-btn {
            background: var(--card);
            border: 1px solid var(--line);
            padding: 16px;
            border-radius: 12px;
            text-decoration: none;
            color: var(--ink);
            font-weight: bold;
            display: flex;
            justify-content: space-between;
            align-items: center;
            opacity: 0.5;
            pointer-events: none;
        }

        .tool-btn.active {
            opacity: 1;
            pointer-events: auto;
            border-left: 5px solid var(--success);
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- HUD HEADER -->
        <header class="hud-header">
            <div class="hud-info">STATUS: <span>ONLINE</span> | TOKENS: <span id="hudTokens">0</span></div>
            <a href="perfil.html" class="btn-perfil" id="btnGoPerfil">⚙️ Perfil</a>
        </header>

        <!-- CARD DO PILOTO -->
        <main>
            <div class="profile-card">
                <img src="elayon_logo.png" alt="Logo Elayon" class="logo-img" onerror="this.style.display='none'">
                <h2 id="userDisplayName">Carregando piloto...</h2>
                <p id="userDisplayEmail">Validando credenciais de acesso...</p>
                <div class="saldo-row">
                    <span class="saldo-texto">Saldo de Tokens: <strong id="cardTokens">0</strong></span>
                    <span id="calibraStatus" style="font-size: 12px; font-weight: bold; color: var(--danger);">⚪ Calibração Pendente</span>
                </div>
            </div>

            <!-- CONFIGURAÇÃO DA IA EXTERNA E CHAVE DO USUÁRIO -->
            <section class="ai-config-card">
                <h3>🧠 Configuração de IA Externa & Chave Pessoal</h3>
                <div class="input-group">
                    <label for="selectAiProvider">Provedor de IA</label>
                    <select id="selectAiProvider">
                        <option value="openai">OpenAI (GPT-4o)</option>
                        <option value="anthropic">Anthropic (Claude 3.5)</option>
                        <option value="gemini" selected>Google Gemini (1.5 Pro)</option>
                    </select>
                </div>
                <div class="input-group">
                    <label for="inputApiKey">Sua Chave de API (API Key)</label>
                    <input type="password" id="inputApiKey" placeholder="Cole sua chave pessoal aqui (ex: AIzaSy...)" autocomplete="off">
                </div>
                <button class="btn-action btn-primary" style="margin-top: 10px; padding: 10px;" onclick="salvarConfigAi()">Salvar Chave e Provedor</button>
            </section>

            <!-- BOTÃO DE CALIBRAÇÃO OBRIGATÓRIA -->
            <div class="section-label">Fase de Inicialização</div>
            <button class="btn-action btn-primary" id="btnIniciarCalibracao" onclick="iniciarCalibracaoSimbiotica()">
                🎙️ Iniciar Calibração da Ferramenta (3 Áudios)
            </button>

            <!-- CHAT GLOBAL COM O AD -->
            <section class="chat-section">
                <h3 style="font-size: 14px; margin-bottom: 10px; color: var(--ink);">💬 Assistente Digital (Ad)</h3>
                <div class="chat-box" id="chatBox">
                    <div class="chat-message ad">
                        Conectando ao núcleo... Realize a calibração com os 3 áudios para ativar a simbiose.
                    </div>
                </div>
                <div style="display: flex; gap: 8px;">
                    <input type="text" id="chatInput" placeholder="Aguardando ativação da simbiose..." disabled style="flex: 1; padding: 10px; border: 1px solid var(--line); border-radius: 8px; font-size: 13px; background: #f0f4f5;">
                    <button class="btn-action btn-primary" id="btnSendChat" disabled style="width: 80px; margin: 0; padding: 10px;" onclick="enviarMensagemChat()">Enviar</button>
                </div>
            </section>

            <!-- FERRAMENTAS LIBERADAS APÓS CALIBRAÇÃO -->
            <div class="section-label">Módulos do Ecossistema</div>
            <div class="tool-grid">
                <a href="#" class="tool-btn" id="btnElayonHealth">Elayon Health (Microfone Ativo) <span>→</span></a>
                <a href="https://paulorobertoxavierjunior-create.github.io/vibracoes-de-leao/" class="tool-btn active" id="btnVibracoes">Vibrações de Leão <span>→</span></a>
            </div>
        </main>
    </div>

    <script>
        const SUPABASE_URL = 'https://xlktkelumtpugidnecbj.supabase.co';
        const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inhsa3RrZWx1bXRwdWdpZG5lY2JqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA3NzU4OTgsImV4cCI6MjEwNjM1MTg5OH0.EIn9oiFl7PmhYhaMlvYKljeFVZflRCbxD_HT65-88XM';
        const supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

        let currentUser = null;
        let tokenCount = 100;
        let calibrado = false;

        async function initCockpit() {
            const { data: { session }, error } = await supabaseClient.auth.getSession();
            
            if (error || !session) {
                window.location.href = 'perfil.html';
                return;
            }

            currentUser = session.user;
            document.getElementById('userDisplayEmail').textContent = currentUser.email;

            // Carregar dados da tabela profiles
            const { data: profile } = await supabaseClient
                .from('profiles')
                .select('*')
                .eq('id', currentUser.id)
                .single();

            if (profile) {
                document.getElementById('userDisplayName').textContent = profile.nome || currentUser.email.split('@')[0];
                tokenCount = profile.tokens ?? 100;
                document.getElementById('hudTokens').textContent = tokenCount;
                document.getElementById('cardTokens').textContent = tokenCount;
                
                if (profile.calibrado) {
                    ativarSimbioseCompleta();
                }
            }

            // Atualiza link de retorno para o perfil mantendo UID
            const perfilUrl = new URL('perfil.html', window.location.href);
            document.getElementById('btnGoPerfil').href = perfilUrl.toString();
        }

        function salvarConfigAi() {
            const provider = document.getElementById('selectAiProvider').value;
            const apiKey = document.getElementById('inputApiKey').value.trim();
            if(!apiKey) {
                alert('Por favor, insira sua chave de API.');
                return;
            }
            localStorage.setItem('elayon_ai_provider', provider);
            localStorage.setItem('elayon_ai_key', apiKey);
            alert('✅ Chave e provedor de IA salvos com sucesso!');
        }

        // Simulação do Fluxo de Calibração (3 áudios brutos -> CRS -> FIFO local -> Ativação do Ad)
        async function iniciarCalibracaoSimbiotica() {
            if (tokenCount < 3) {
                alert('Tokens insuficientes para a calibração (Necessário 3 tokens).');
                return;
            }

            const confirmar = confirm('A calibração iniciará a captação sequencial de 3 áudios brutos. Deseja prosseguir?');
            if (!confirmar) return;

            // Desconta 3 tokens na memória e atualiza interface
            tokenCount -= 3;
            document.getElementById('hudTokens').textContent = tokenCount;
            document.getElementById('cardTokens').textContent = tokenCount;

            // Simula o processo de captação e envio sequencial para o CRS-full
            document.getElementById('btnIniciarCalibracao.disabled = true;
            document.getElementById('calibraStatus').textContent = '⏳ Processando 3 áudios no CRS...';

            setTimeout(async () => {
                // Atualiza status no Supabase
                await supabaseClient
                    .from('profiles')
                    .update({ tokens: tokenCount, calibrado: true })
                    .eq('id', currentUser.id);

                ativarSimbioseCompleta();
            }, 3000);
        }

        function ativarSimbioseCompleta() {
            calibrado = true;
            document.getElementById('calibraStatus.textContent = '✅ Calibração Concluída';
            document.getElementById('calibraStatus').style.color = 'var(--success)';
            document.getElementById('btnIniciarCalibracao').style.display = 'none';

            // Habilita Chat e Módulos
            document.getElementById('chatInput').disabled = false;
            document.getElementById('chatInput').placeholder = 'Converse com o Ad por texto ou voz...';
            document.getElementById('btnSendChat').disabled = false;
            document.getElementById('btnElayonHealth').classList.add('active');

            // Mensagem de boas-vindas do Ad com a nova identidade
            const chatBox = document.getElementById('chatBox');
            chatBox.innerHTML += `
                <div class="chat-message ad">
                    Conexão Simbiótica Ativada.<br><br>
                    Seja bem-vindo ao Elayon Space. O seu espaço de Escuta Simbólica.<br><br>
                    Como vamos operar hoje?
                </div>
            `;
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        function enviarMensagemChat() {
            const input = document.getElementById('chatInput');
            const texto = input.value.trim();
            if(!texto) return;

            const chatBox = document.getElementById('chatBox');
            chatBox.innerHTML += `<div class="chat-message user">${texto}</div>`;
            input.value = '';

            // Consome 1 token por interação
            if(tokenCount > 0) {
                tokenCount -= 1;
                document.getElementById('hudTokens').textContent = tokenCount;
                document.getElementById('cardTokens').textContent = tokenCount;
            }

            setTimeout(() => {
                chatBox.innerHTML += `
                    <div class="chat-message ad">
                        Análise de fluxo CRS integrada. Operando com IA e API externa conectada. Como posso auxiliar no seu ecossistema?
                    </div>
                `;
                chatBox.scrollTop = chatBox.scrollHeight;
            }, 1000);
        }

        initCockpit();
    </script>
</body>
</html>
